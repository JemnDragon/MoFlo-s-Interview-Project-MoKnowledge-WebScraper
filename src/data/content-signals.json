  "_companyRoleComment": "Self-descriptions of what kind of operation this is. Matched against page text only as a fallback when schema.org says nothing — these are phrases the business writes about itself, not inferences from what it happens to sell. Ordered: the first role matched wins, so more specific roles come first. 'audiences' are matched separately and prefixed, mirroring the reference format 'Direct-to-Consumer (D2C) and Business-to-Business (B2B) Service Provider'.",
  "companyRoles": [
    { "label": "Manufacturer", "phrases": ["we manufacture", "our manufacturing", "manufacturer of", "we build our own", "our factory"] },
    { "label": "Distributor", "phrases": ["distributor of", "we distribute", "wholesale supplier", "wholesaler"] },
    { "label": "Contractor", "phrases": ["general contractor", "licensed contractor", "we are a contractor", "contracting company"] },
    { "label": "Agency", "phrases": ["we are an agency", "our agency", "full-service agency", "marketing agency", "creative agency"] },
    { "label": "Consultancy", "phrases": ["consulting firm", "we are a consultancy", "consultancy", "advisory firm"] },
    { "label": "Retailer", "phrases": ["our retail", "retail location", "our store", "we are a retailer", "online store", "shop our collection"] },
    { "label": "Service provider", "phrases": ["service provider", "full-service", "services company", "we provide services", "our services include"] }
  ],
  "companyRoleAudiences": [
    { "label": "Direct-to-Consumer (D2C)", "phrases": ["direct-to-consumer", "direct to consumer", "d2c"] },
    { "label": "Business-to-Business (B2B)", "phrases": ["business-to-business", "b2b"] }
  ],
